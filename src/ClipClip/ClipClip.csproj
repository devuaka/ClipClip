<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\ClipClip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClipClip</AssemblyName>
    <RootNamespace>ClipClip</RootNamespace>
    <Version>1.0.0</Version>
    <Product>ClipClip</Product>
    <Company>ClipClip</Company>
    <Description>ClipClip instant replay</Description>
    <StartupObject>ClipClip.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipClip.Engine\ClipClip.Engine.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\ClipClip.ico" />
    <EmbeddedResource Include="Assets\tray-*.ico" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
