<UserControl x:Class="ClipClip.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <TextBlock Style="{StaticResource H1}" Text="Games" />
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding AddCommand}" AutomationProperties.Name="Add game">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Stroke="White" Margin="-4,0,6,0" />
                    <TextBlock Text="Add game" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Live detection -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid Width="12" Height="12" Margin="2,0,14,0" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource Ready}" Visibility="{Binding HasGame, Converter={StaticResource BoolVisible}}" />
                    <Ellipse Fill="{StaticResource TextFaint}" Visibility="{Binding HasGame, Converter={StaticResource BoolHidden}}" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource H2}" Text="{Binding CurrentName}" />
                    <TextBlock Style="{StaticResource Dim}" Text="{Binding CurrentDetail}" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding AutoDetect}" VerticalAlignment="Center" AutomationProperties.Name="Detect games automatically">
                    <StackPanel>
                        <TextBlock Text="Detect games automatically" Foreground="{StaticResource Text}" FontSize="14" />
                        <TextBlock Style="{StaticResource Faint}" Text="Your custom list always works" />
                    </StackPanel>
                </CheckBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Custom games -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource H2}" Text="Custom games" />
                        <TextBlock Style="{StaticResource Faint}" Text="Picked by you. Recognized the moment the .exe launches." Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Custom}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,6,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Game name" />
                                            <TextBlock Style="{StaticResource Faint}" Text="{Binding ExePath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" Margin="2,3,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="12,0,6,0" VerticalAlignment="Top" ToolTip="Detect this game" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Remove" AutomationProperties.Name="Remove game"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Style="{StaticResource Dim}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                               Text="Game not being picked up? Add its .exe here." Visibility="{Binding HasCustom, Converter={StaticResource BoolHidden}}" />
                </Grid>
            </Border>

            <!-- Found automatically -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource H2}" Text="Found automatically" />
                        <TextBlock Style="{StaticResource Faint}" Text="{Binding DetectedCount}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter games" />
                        <TextBlock Text="Filter games" Foreground="{StaticResource TextFaint}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Filter, Converter={StaticResource NoValue}}" />
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Detected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,10,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Faint}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
