<UserControl x:Class="ClipClip.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClipClip.Controls"
             Focusable="True" PreviewKeyDown="OnKey">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="AssetButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <!-- Header: project, undo, export -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="NameBox" Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Display}" FontSize="22"
                         FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="2,2" MinWidth="160" MaxWidth="320"
                         ToolTip="Rename the project" AutomationProperties.Name="Project name" KeyDown="OnNameKey" />
                <Button Style="{StaticResource GhostButton}" Content="Projects" Margin="8,0,0,0" Click="OnProjects" AutomationProperties.Name="Projects" />
                <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Margin="8,0,0,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconUndo}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRedo}" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="240">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Faint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                    <ProgressBar Height="4" Margin="0,4,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource Live}" Background="{StaticResource Bg3}"
                                 BorderThickness="0" Width="160" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisible}}" />
                </StackPanel>
                <ComboBox Width="168" ItemsSource="{Binding AspectChoices}" SelectedValue="{Binding Aspect}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Video shape" />
                <ComboBox Width="92" Margin="8,0,0,0" ItemsSource="{Binding FpsChoices}" SelectedValue="{Binding Fps}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Frame rate" />
                <Button Content="Watch it" Margin="8,0,0,0" Command="{Binding ShowResultCommand}" Visibility="{Binding HasResult, Converter={StaticResource BoolVisible}}" />
                <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisible}}" />
                <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ExportCommand}" IsEnabled="{Binding HasClips}" AutomationProperties.Name="Export video">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconExport}" Stroke="White" Margin="-4,0,6,0" />
                        <TextBlock Text="Export" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Assets, preview, inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="258" />
            </Grid.ColumnDefinitions>

            <!-- Assets -->
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Bg0}" CornerRadius="9" Padding="2" Margin="0,0,0,10">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource Tab}" GroupName="Assets" Content="Media" IsChecked="{Binding IsMediaTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="Assets" Content="Text" IsChecked="{Binding IsTextTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="Assets" Content="Stickers" IsChecked="{Binding IsStickersTab}" />
                            <RadioButton Style="{StaticResource Tab}" GroupName="Assets" Content="Audio" IsChecked="{Binding IsAudioTab}" />
                        </UniformGrid>
                    </Border>

                    <!-- Media -->
                    <Grid Grid.Row="1" Visibility="{Binding IsMediaTab, Converter={StaticResource BoolVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="Import a video..." Command="{Binding ImportVideoCommand}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Media}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AssetButton}" Padding="6" ToolTip="Add to the end of the timeline" AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding DataContext.AddMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="40" CornerRadius="5" Background="{StaticResource Bg2}" ClipToBounds="True">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Text presets -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsTextTab, Converter={StaticResource BoolVisible}}">
                        <TextBlock Style="{StaticResource Faint}" Text="Added at the playhead." Margin="0,0,0,10" />
                        <Button Style="{StaticResource AssetButton}" Command="{Binding AddTextCommand}" CommandParameter="title">
                            <TextBlock Text="Title" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource AssetButton}" Command="{Binding AddTextCommand}" CommandParameter="callout">
                            <TextBlock Text="NO WAY" FontFamily="Impact" FontSize="20" Foreground="#FFE14D" HorizontalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource AssetButton}" Command="{Binding AddTextCommand}" CommandParameter="caption">
                            <TextBlock Text="Caption" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource AssetButton}" Command="{Binding AddTextCommand}" CommandParameter="subtitle">
                            <TextBlock Text="Subtitle" FontSize="12" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Stickers -->
                    <Grid Grid.Row="1" Visibility="{Binding IsStickersTab, Converter={StaticResource BoolVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="Your own image..." Command="{Binding ImportStickerCommand}" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Stickers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Padding="6" Margin="2" Height="64" ToolTip="Add sticker"
                                                Command="{Binding DataContext.AddStickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Image Source="{Binding}" Stretch="Uniform" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Audio -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsAudioTab, Converter={StaticResource BoolVisible}}">
                        <Button Style="{StaticResource AssetButton}" Command="{Binding ImportAudioCommand}" Content="Add music or a sound..." />
                        <Button Style="{StaticResource AssetButton}" Command="{Binding RecordVoiceCommand}" AutomationProperties.Name="Record voiceover">
                            <Grid>
                                <TextBlock Text="Record voiceover" HorizontalAlignment="Center" Visibility="{Binding IsRecording, Converter={StaticResource BoolHidden}}" />
                                <TextBlock Text="Stop recording" HorizontalAlignment="Center" Foreground="{StaticResource Live}" FontWeight="Bold"
                                           Visibility="{Binding IsRecording, Converter={StaticResource BoolVisible}}" />
                            </Grid>
                        </Button>
                        <TextBlock Style="{StaticResource Faint}" Text="The video plays without sound while you talk, starting at the playhead." />
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0">
                            <Run Text="Microphone:" /> <Run Text="{Binding MicName, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="Black" CornerRadius="12" ClipToBounds="True">
                    <Grid x:Name="Stage" SizeChanged="OnStageSized" Background="Transparent" MouseLeftButtonDown="OnStageDown">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="OverlayCanvas">
                            <Border x:Name="LayerBox" BorderBrush="White" BorderThickness="1.5" CornerRadius="3" Background="#01000000" Cursor="SizeAll"
                                    Visibility="Collapsed" MouseLeftButtonDown="OnBoxDown" MouseMove="OnBoxMove" MouseLeftButtonUp="OnBoxUp" ToolTip="Drag to move" />
                        </Canvas>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasClips, Converter={StaticResource BoolHidden}}">
                            <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" Text="Start a project" />
                            <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="320"
                                       Text="Click a clip under Media to put it on the timeline, or use Edit in Studio from My Clips." />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Display}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnPlay" ToolTip="Play or pause (Space)" AutomationProperties.Name="Play preview">
                        <Path x:Name="PlayGlyph" Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" />
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Command="{Binding SplitCommand}" ToolTip="Split at the playhead (S)" AutomationProperties.Name="Split">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconScissors}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateCommand}" ToolTip="Duplicate (Ctrl+D)" AutomationProperties.Name="Duplicate">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="Delete (Del)" AutomationProperties.Name="Delete">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Inspector -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,4,14,12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  RangeBase.ValueChanged="OnInspectorEdited" Selector.SelectionChanged="OnInspectorEdited"
                                  TextBoxBase.TextChanged="OnInspectorEdited" ToggleButton.Checked="OnInspectorEdited" ToggleButton.Unchecked="OnInspectorEdited">
                        <StackPanel>
                            <!-- Video -->
                            <StackPanel Visibility="{Binding IsVideoSelected, Converter={StaticResource BoolVisible}}">
                                <TextBlock Style="{StaticResource Label}" Text="SPEED" />
                                <ComboBox ItemsSource="{Binding SpeedChoices}" SelectedValue="{Binding SelectedVideo.Speed}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Speed" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SelectedVideo.KeepPitch}" Margin="0,8,0,0">
                                    <TextBlock Text="Keep voices normal" Foreground="{StaticResource TextDim}" FontSize="12" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Label}" Text="VOLUME" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="2" Value="{Binding SelectedVideo.Volume}" IsEnabled="{Binding SelectedVideo.Muted, Converter={StaticResource Not}}" AutomationProperties.Name="Volume" />
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SelectedVideo.Muted}" Margin="10,0,0,0">
                                        <TextBlock Text="Mute" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,6,0" />
                                    </CheckBox>
                                </Grid>
                                <TextBlock Style="{StaticResource Label}" Text="TRANSITION IN" />
                                <ComboBox ItemsSource="{Binding TransitionChoices}" SelectedValue="{Binding SelectedVideo.Transition}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Transition" />
                                <Slider Minimum="0.2" Maximum="2" Value="{Binding SelectedVideo.TransitionSeconds}" Margin="0,6,0,0" ToolTip="Transition length" AutomationProperties.Name="Transition length" />
                                <TextBlock Style="{StaticResource Label}" Text="EFFECT" />
                                <ComboBox ItemsSource="{Binding MotionChoices}" SelectedValue="{Binding SelectedVideo.Motion}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Effect" />
                                <TextBlock Style="{StaticResource Label}" Text="FILTER" />
                                <ComboBox ItemsSource="{Binding FilterChoices}" SelectedValue="{Binding SelectedVideo.Filter}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Filter" />
                                <TextBlock Style="{StaticResource Faint}" Text="Brightness" Margin="0,10,0,0" />
                                <Slider Minimum="-0.4" Maximum="0.4" Value="{Binding SelectedVideo.Brightness}" AutomationProperties.Name="Brightness" />
                                <TextBlock Style="{StaticResource Faint}" Text="Contrast" Margin="0,6,0,0" />
                                <Slider Minimum="0.5" Maximum="1.6" Value="{Binding SelectedVideo.Contrast}" AutomationProperties.Name="Contrast" />
                                <TextBlock Style="{StaticResource Faint}" Text="Saturation" Margin="0,6,0,0" />
                                <Slider Minimum="0" Maximum="2" Value="{Binding SelectedVideo.Saturation}" AutomationProperties.Name="Saturation" />
                            </StackPanel>

                            <!-- Text -->
                            <StackPanel Visibility="{Binding IsTextSelected, Converter={StaticResource BoolVisible}}">
                                <TextBlock Style="{StaticResource Label}" Text="TEXT" />
                                <TextBox Text="{Binding SelectedLayer.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" AutomationProperties.Name="Text" />
                                <TextBlock Style="{StaticResource Label}" Text="FONT" />
                                <ComboBox ItemsSource="{Binding FontChoices}" SelectedItem="{Binding SelectedLayer.Font}" AutomationProperties.Name="Font">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Label}" Text="SIZE" />
                                <Slider Minimum="0.025" Maximum="0.2" Value="{Binding SelectedLayer.Size}" AutomationProperties.Name="Text size" />
                                <TextBlock Style="{StaticResource Label}" Text="COLOR" />
                                <ItemsControl ItemsSource="{Binding ColorChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="22" Margin="2" Padding="0" Background="{Binding}" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SelectedLayer.Bold}" Margin="0,0,8,0">
                                        <TextBlock Text="Bold" Foreground="{StaticResource TextDim}" FontSize="12" />
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SelectedLayer.Outline}">
                                        <TextBlock Text="Outline" Foreground="{StaticResource TextDim}" FontSize="12" />
                                    </CheckBox>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Label}" Text="ANIMATION" />
                                <ComboBox ItemsSource="{Binding AnimationChoices}" SelectedValue="{Binding SelectedLayer.Animation}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Animation" />
                                <TextBlock Style="{StaticResource Faint}" Text="Drag the box on the preview to move it." Margin="0,12,0,0" />
                            </StackPanel>

                            <!-- Sticker -->
                            <StackPanel Visibility="{Binding IsStickerSelected, Converter={StaticResource BoolVisible}}">
                                <TextBlock Style="{StaticResource Label}" Text="SIZE" />
                                <Slider Minimum="0.05" Maximum="1" Value="{Binding SelectedLayer.Size}" AutomationProperties.Name="Sticker size" />
                                <TextBlock Style="{StaticResource Label}" Text="ANIMATION" />
                                <ComboBox ItemsSource="{Binding AnimationChoices}" SelectedValue="{Binding SelectedLayer.Animation}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="Sticker animation" />
                                <TextBlock Style="{StaticResource Faint}" Text="Drag the box on the preview to move it." Margin="0,12,0,0" />
                            </StackPanel>

                            <!-- Audio -->
                            <StackPanel Visibility="{Binding IsAudioSelected, Converter={StaticResource BoolVisible}}">
                                <TextBlock Style="{StaticResource Label}" Text="VOLUME" />
                                <Slider Minimum="0" Maximum="2" Value="{Binding SelectedAudio.Volume}" AutomationProperties.Name="Audio volume" />
                                <TextBlock Style="{StaticResource Label}" Text="FADE IN" />
                                <Slider Minimum="0" Maximum="5" Value="{Binding SelectedAudio.FadeIn}" AutomationProperties.Name="Fade in" />
                                <TextBlock Style="{StaticResource Label}" Text="FADE OUT" />
                                <Slider Minimum="0" Maximum="5" Value="{Binding SelectedAudio.FadeOut}" AutomationProperties.Name="Fade out" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" VerticalAlignment="Center" Margin="6"
                               Text="Click anything on the timeline to edit it here." Visibility="{Binding HasSelection, Converter={StaticResource BoolHidden}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,6,8,4">
                    <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center"
                               Text="Drag pieces to move them, drag their edges to trim. S splits, Ctrl+scroll zooms." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Padding="10,4" Content="-" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out" AutomationProperties.Name="Zoom out" />
                        <Button Style="{StaticResource GhostButton}" Padding="10,4" Content="+" Command="{Binding ZoomInCommand}" ToolTip="Zoom in" AutomationProperties.Name="Zoom in" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <c:TimelineControl x:Name="Timeline" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
