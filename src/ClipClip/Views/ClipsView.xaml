<UserControl x:Class="ClipClip.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Library grid -->
        <Grid Visibility="{Binding IsPlayerOpen, Converter={StaticResource BoolHidden}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="My Clips" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="14" Text="{Binding CountText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="260" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" AutomationProperties.Name="Search clips" />
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" HorizontalAlignment="Left" Margin="8,0,0,0" Stroke="{StaticResource TextFaint}" IsHitTestVisible="False" />
                        <TextBlock Text="Search by name or game" Foreground="{StaticResource TextFaint}" FontSize="13" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource NoValue}}" />
                    </Grid>
                    <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" AutomationProperties.Name="Sort clips" />
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding OpenClipFolderCommand}" ToolTip="Open clip folder">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardRoot" Width="252" Margin="0,0,14,14" Style="{StaticResource Card}" Background="{StaticResource Bg1}">
                                <StackPanel>
                                    <Button Padding="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="Play" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Grid Height="140">
                                            <Border CornerRadius="13,13,0,0" Background="{StaticResource Bg2}">
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="250" Height="140" Background="Black" CornerRadius="13,13,0,0" />
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="46" Height="46" CornerRadius="23" Background="#B0000000" x:Name="PlayBadge" Opacity="0">
                                                <Path Data="{StaticResource IconPlay}" Fill="White" Width="20" Height="20" Stretch="None" />
                                            </Border>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Background="#C0000000" CornerRadius="5" Padding="6,2">
                                                <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="White" FontFamily="{StaticResource Display}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Grid Margin="12,10,6,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Faint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                <Run Text="{Binding Game, Mode=OneWay}" Foreground="{StaticResource TextDim}" /><Run Text="  &#183;  " /><Run Text="{Binding When, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Export a copy" AutomationProperties.Name="Export"
                                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconExport}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play" Command="{Binding PlacementTarget.Tag.PlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Export a copy" Command="{Binding PlacementTarget.Tag.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Copy to clipboard" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Show in File Explorer" Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <MenuItem Header="Open in default player" Command="{Binding PlacementTarget.Tag.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </Border.Tag>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource TextFaint}" />
                                    <Setter TargetName="PlayBadge" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisible}}">
                <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" Text="No clips yet" Visibility="{Binding LibraryHasClips, Converter={StaticResource BoolHidden}}" />
                <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" Text="Nothing matches that search" Visibility="{Binding LibraryHasClips, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" Text="Clips are saved as normal MP4 files in your clip folder." />
            </StackPanel>
        </Grid>

        <!-- Player -->
        <Grid Visibility="{Binding IsPlayerOpen, Converter={StaticResource BoolVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Command="{Binding ClosePlayerCommand}" ToolTip="Back to My Clips" AutomationProperties.Name="Back">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBack}" />
                </Button>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" FontSize="20" Text="{Binding Playing.Title}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolHidden}}" />
                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnRenameKey" AutomationProperties.Name="Clip name" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0" Command="{Binding ConfirmRenameCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Cancel" Margin="4,0,0,0" Command="{Binding CancelRenameCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0">
                        <Run Text="{Binding Playing.Game, Mode=OneWay}" Foreground="{StaticResource TextDim}" /><Run Text="  &#183;  " /><Run Text="{Binding Playing.When, Mode=OneWay}" /><Run Text="  &#183;  " /><Run Text="{Binding Playing.Resolution, Mode=OneWay}" /><Run Text="  &#183;  " /><Run Text="{Binding Playing.Size, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="0,0,8,0" AutomationProperties.Name="Export">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconExport}" Stroke="White" Margin="-4,0,6,0" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="Copy to clipboard" AutomationProperties.Name="Copy">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding StartRenameCommand}" Click="OnStartRename" ToolTip="Rename" AutomationProperties.Name="Rename">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconRename}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenFolderCommand}" ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenExternalCommand}" ToolTip="Open in default player" AutomationProperties.Name="Open externally">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconExternal}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="Delete" AutomationProperties.Name="Delete">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="Black" CornerRadius="14" ClipToBounds="True">
                <Grid MouseLeftButtonUp="OnVideoClick" Background="Transparent">
                    <Border x:Name="PlayerHost" />
                    <TextBlock x:Name="PlayerError" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Click="OnPlayPause" AutomationProperties.Name="Play or pause">
                    <Path x:Name="PlayGlyph" Style="{StaticResource Icon}" Data="{StaticResource IconPause}" />
                </Button>
                <TextBlock x:Name="PositionText" Grid.Column="1" Text="0:00" FontFamily="{StaticResource Display}" Foreground="{StaticResource TextDim}" Width="44" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="4,0,12,0" />
                <Slider x:Name="Seek" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1"
                        Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd" PreviewMouseLeftButtonUp="OnSeekClick" AutomationProperties.Name="Seek" />
                <TextBlock x:Name="DurationText" Grid.Column="3" Text="0:00" FontFamily="{StaticResource Display}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="12,0" />
                <Path Grid.Column="4" Style="{StaticResource Icon}" Data="{StaticResource IconVolume}" Stroke="{StaticResource TextDim}" Margin="0,0,8,0" />
                <Slider x:Name="Volume" Grid.Column="5" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volume" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
