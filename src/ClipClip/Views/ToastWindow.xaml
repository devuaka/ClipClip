<Window x:Class="ClipClip.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource Body}">
    <Border x:Name="Root" Margin="16" Background="#F212141A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"
            Padding="14,12,22,12" MinWidth="240" MaxWidth="360" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="30" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Badge" Width="32" Height="32" CornerRadius="16" Background="{StaticResource Ember}" Margin="0,0,12,0">
                <Path x:Name="Glyph" Data="M6.5,12 L10.5,16 L17.5,8.5" Stroke="White" StrokeThickness="2.2" Width="24" Height="24"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="15" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Dim}" MaxWidth="280" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
